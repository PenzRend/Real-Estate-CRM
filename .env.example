# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings → API). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/test-only. Bypasses RLS. Never import in app code, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI (server-only). Option A, recommended for quality: Claude.
#   ANTHROPIC_API_KEY=...            AI_MODEL defaults to claude-opus-5-5;
#   set AI_MODEL=claude-haiku-5-5 for the lowest cost (see docs/COSTS.md).
ANTHROPIC_API_KEY=
AI_MODEL=

# Option B (free tiers for testing, e.g. Groq): any OpenAI-compatible endpoint.
#   AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=<a chat model>
AI_BASE_URL=
AI_API_KEY=

# Voice memos: OpenAI-compatible /audio/transcriptions endpoint.
# Falls back to AI_BASE_URL / AI_API_KEY when these are empty.
#   Groq: TRANSCRIBE_MODEL=whisper-large-v3   OpenAI: gpt-4o-transcribe
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=

# Gmail connection (server-only). See docs/GMAIL_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored mailbox connections unreadable (users must reconnect).
MAIL_TOKEN_KEY=

# Import extension store listings (optional). When set, the import page's
# install card links there instead of offering the zip download.
EXTENSION_CHROME_URL=
EXTENSION_SAFARI_URL=

# Shown on the public privacy policy (/adatvedelem).
PRIVACY_CONTROLLER=
PRIVACY_EMAIL=
