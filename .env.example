# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings → API). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/test-only. Bypasses RLS. Never import in app code, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI: any OpenAI-compatible chat-completions endpoint (server-only). See docs/PLAN.md §6.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
